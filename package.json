{
  "name": "offhand-mcp",
  "version": "0.1.0",
  "description": "MCP server for Adobe After Effects. Typed tools first, ExtendScript only when you ask for it.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "offhand": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "extension",
    "scripts",
    "assets",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "after-effects",
    "adobe",
    "extendscript",
    "cep",
    "automation",
    "ai"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "install:cep": "node scripts/install-cep.mjs",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
